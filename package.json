{
  "name": "interview-studio",
  "version": "0.2.9",
  "private": true,
  "description": "Local Korean technical interview practice studio powered by installed AI CLIs.",
  "main": "./out/main/index.js",
  "author": "Interview Studio",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package:mac": "pnpm build && electron-builder --mac dmg zip",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@echogarden/windows-media-tts": "0.1.2",
    "@huggingface/transformers": "4.3.0",
    "@napi-rs/canvas": "^0.1.80",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.9.3",
    "tesseract.js": "^6.0.1",
    "xstate": "^5.33.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.0"
  }
}
